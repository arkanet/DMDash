{
  "name": "@dmdash/monorepo",
  "version": "2.7.0-0",
  "type": "module",
  "description": "DMDash web client and DarkMesh iOS app monorepo",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkanet/DMDash.git"
  },
  "bugs": {
    "url": "https://github.com/arkanet/DMDash/issues"
  },
  "homepage": "https://github.com/arkanet/DMDash",
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "oxfmt"
    ]
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm lint && pnpm format",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "sync:system": "bash ./scripts/sync-system.sh",
    "sync:system:update": "bash ./scripts/sync-system.sh --update-working-trees",
    "sync:pictures": "bash ./scripts/sync-pictures.sh",
    "sync:pictures:strict": "bash ./scripts/sync-pictures.sh --strict",
    "sync:upstreams": "bash ./scripts/sync-upstreams.sh",
    "sync:upstreams:update": "bash ./scripts/sync-upstreams.sh --update-working-trees",
    "check:device-images": "node ./scripts/check-device-images.mjs --strict",
    "report:device-images": "node ./scripts/check-device-images.mjs --write",
    "report:compatibility": "bash ./scripts/report-compatibility.sh --write",
    "build:all": "pnpm run --filter '*' build",
    "clean:all": "pnpm run --filter '*' clean",
    "publish:packages": "pnpm run build --filter 'packages/transport-*'",
    "mobile:add:ios": "pnpm --filter @dmdash/mobile run add:ios",
    "mobile:sync": "pnpm --filter @dmdash/mobile run sync:all",
    "mobile:clean:ios": "rm -rf packages/mobile/ios/DerivedData",
    "mobile:package:ios": "bash ./scripts/package-ios-ipa.sh",
    "mobile:build:ios": "pnpm mobile:clean:ios && pnpm mobile:sync && xcodebuild -project packages/mobile/ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS' -derivedDataPath packages/mobile/ios/DerivedData CODE_SIGNING_ALLOWED=NO build && pnpm mobile:package:ios",
    "mobile:build:ios:device": "test -n \"$IOS_DEVICE_ID\" || (echo \"Set IOS_DEVICE_ID=<device-udid>\" && exit 1); pnpm mobile:clean:ios && pnpm mobile:sync && xcodebuild -project packages/mobile/ios/App/App.xcodeproj -scheme App -configuration Debug -destination \"platform=iOS,id=$IOS_DEVICE_ID\" -derivedDataPath packages/mobile/ios/DerivedData -allowProvisioningUpdates build && pnpm mobile:package:ios",
    "mobile:archive:ios": "pnpm mobile:clean:ios && pnpm mobile:sync && xcodebuild -project packages/mobile/ios/App/App.xcodeproj -scheme App -configuration Release -destination 'generic/platform=iOS' -derivedDataPath packages/mobile/ios/DerivedData -archivePath packages/mobile/ios/build/DarkMesh.xcarchive archive && DARKMESH_APP_PATH=packages/mobile/ios/build/DarkMesh.xcarchive/Products/Applications/App.app pnpm mobile:package:ios",
    "mobile:ios": "pnpm --filter @dmdash/mobile run open:ios",
    "mobile:doctor": "pnpm --filter @dmdash/mobile run doctor",
    "test": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@meshtastic/protobufs": "workspace:*",
    "emoji-picker-react": "^4.9.0",
    "ste-simple-events": "^3.0.11",
    "tailwind-merge": "^3.5.0",
    "tslog": "^4.9.3"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "glob": "^13.0.6",
    "husky": "^9.1.0",
    "lint-staged": "^16.0.0",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.41.0",
    "source-map": "0.7.4",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@serialport/bindings-cpp",
      "@tailwindcss/oxide",
      "core-js",
      "esbuild"
    ]
  }
}
